        "taskType": "Major",
        "performType": "ANY",
        "autoExecute": "N"
      },
      "text": { "x": 480, "y": 280, "value": "提交申请" }
    },
    {
      "id": "custom1",
      "type": "snaker:custom",
      "x": 680,
      "y": 280,
      "properties": {
        "width": 120, "height": 80,
        "clazz": "com.mldong.config.AmountCalculateHandler",
        "methodName": "calculate",
