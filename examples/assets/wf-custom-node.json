      "x": 280,
      "y": 280,
      "properties": { "width": 120, "height": 80 },
      "text": { "x": 280, "y": 320, "value": "开始" }
    },
    {
      "id": "apply",
      "type": "snaker:task",
      "x": 480,
      "y": 280,
      "properties": {
        "width": 120, "height": 80,
