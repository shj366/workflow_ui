{
  "name": "@mldong/jeeflow-ui",
  "version": "0.1.0",
  "description": "jeeflow 流程中心组件包——基于统一门面（40 action）的通用流程 UI，可集成到任意业务系统",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": ["src", "types"],
  "scripts": {
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly --outDir dist"
  },
  "peerDependencies": {
    "vue": "^3.4.0",
    "mldong-flow-designer-plus": "^3.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.5",
    "mldong-flow-designer-plus": "^3.1.1",
    "typescript": "^5.5.0",
    "vite": "^5.3.1",
    "vue": "^3.4.30",
    "vue-tsc": "^2.0.0"
  },
  "keywords": ["workflow", "jeeflow", "流程", "工作流", "facade"],
  "license": "Apache-2.0"
}
