{
  "name": "mldong-flow-designer-plus",
  "private": false,
  "version": "3.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:lib": "vue-tsc -b && vite build --config vite.config.lib.ts",
    "build:lib:lite": "vue-tsc -b && vite build --config vite.config.lib.lite.ts",
    "publish:lite": "node scripts/publish-lite.mjs",
    "postinstall": "node postinstall.mjs",
    "preview": "vite preview"
  },
  "pnpm": {
    "overrides": {
      "rollup": "npm:@rollup/wasm-node@4.62.3"
    }
  },
  "keywords": [
    "工作流",
    "流程设计器",
    "Web流程设计器",
    "Vue3",
    "LogicFlow",
    "钉钉风格",
    "零 UI 框架依赖"
  ],
  "main": "./lib/mldong-flow-designer-plus.umd.cjs",
  "module": "./lib/mldong-flow-designer-plus.js",
  "types": "./packages/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./packages/types/index.d.ts",
      "import": "./lib/mldong-flow-designer-plus.js",
      "require": "./lib/mldong-flow-designer-plus.umd.cjs"
    },
    "./lib/style.css": "./lib/style.css",
    "./*": "./*"
  },
  "files": [
    "lib",
    "packages",
    "postinstall.mjs"
  ],
  "author": "mldong",
  "license": "Apache License 2.0",
  "homepage": "https://www.npmjs.com/package/mldong-flow-designer-plus",
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/mldong/flow-designer.git"
  },
  "bugs": {
    "url": "https://gitee.com/mldong/flow-designer/issues"
  },
  "dependencies": {
    "@logicflow/core": "^2.2.3",
    "@logicflow/extension": "^2.2.3",
    "@logicflow/layout": "^2.1.3",
    "vue": "^3.4.30"
  },
  "devDependencies": {
    "@rollup/wasm-node": "4.62.3",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^5.0.5",
    "element-plus": "^2.7.8",
    "sass": "^1.100.0",
    "typescript": "^5.2.2",
    "vite": "^5.3.1",
    "vue-tsc": "3.3.9"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  }
}
